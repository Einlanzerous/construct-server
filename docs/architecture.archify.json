    "views": [
      {
        "id": "tunneled-path",
        "label": "A tunneled request",
        "focus": [
          "people",
          "cloudflare",
          "traefik",
          "guard",
          "services"
        ],
        "note": "Access at the Cloudflare edge, the tunnel into the unpublished internal entrypoint, then the origin re-verifies the JWT."
      },
      {
        "id": "public-path",
        "label": "The open WAN path",
        "focus": [
          "people",
          "traefik",
          "crowdsec",
          "services"
        ],
        "note": "Only the public entrypoint is published. It serves a short allowlist of direct routers behind CrowdSec and denies everything else."
      },
      {
        "id": "delivery",
        "label": "How the stack is delivered",
        "focus": [
          "signet",
          "deploy",
          "services",
          "wiki"
        ],
        "note": "Signet renders the env secret, deploy.yml merges it with the image pins and brings the stack up, and the wiki publishes beside it."
      }
    ]
