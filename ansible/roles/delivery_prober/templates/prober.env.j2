# {{ ansible_managed }}
# Delivery prober credentials + configuration (SERV-111).
# Consumed by delivery-prober.service via EnvironmentFile.
#
# SWITCHYARD_TOKEN carries `deployments:observe` and MUST NOT carry
# `deployments:write`: an observation corroborates a claim, and the matrix's
# `claimed_not_confirmed` state only means something if corroborating is the
# harder of the two. Mint it with scripts/mint-prober-token.sh.
#
# This file is the single config for EVERY host-side producer that posts to the
# delivery ledger. When SWY-194's container-inspect collector lands it reads
# these same variables from this same file — do not give it its own.
SWITCHYARD_URL={{ delivery_prober_switchyard_url }}
SWITCHYARD_TOKEN={{ delivery_prober_token }}
PROBE_ENVIRONMENT={{ delivery_prober_environment }}
PROBE_TARGETS={% for name, base in delivery_prober_targets.items() %}{{ name }}={{ base }}{% if not loop.last %},{% endif %}{% endfor %}

