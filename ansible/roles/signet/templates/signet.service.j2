# {{ ansible_managed }}
# Signet host daemon — credential vault + outbound-sync REST API (SGNT / SERV-44).
# Consumed by Switchyard's Signet connector (SWY-165) over host.docker.internal:4010.
[Unit]
Description=Signet credential vault + sync daemon
Documentation=https://github.com/Einlanzerous/signet
After=network-online.target
Wants=network-online.target
# SIGNET_ADDR names the docker0 gateway, which does not exist until dockerd has
# created the bridge. The daemon deliberately refuses to start if any listed
# address fails to bind — half-listening is the failure SGNT-17 exists to
# prevent — so without this ordering a reboot that wins the race against Docker
# takes Signet down entirely, loopback included (SERV-65).
After=docker.service
Wants=docker.service

# Restart=always below means a genuinely broken config (missing
# SIGNET_API_TOKEN, an unbindable address) would otherwise retry forever: the
# systemd defaults are a 5-restart burst inside 10s, but RestartSec=5s spaces
# five attempts over ~25s so the limit never trips. The journal shows this
# reaching restart counter 58 on 2026-07-26. A 5-minute window makes the burst
# land inside it, so a broken unit ends in `failed` where it can be seen, while
# the days-apart clean exits this daemon actually suffers still restart (SERV-70).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ signet_user }}
Group={{ signet_user }}
# SIGNET_API_TOKEN (bearer required by the API) + any overrides.
# Leading `-`: the file is only written when a token is available, so on a host
# without the sops key it may not exist. Without the dash systemd refuses to
# start on the missing file; with it, the daemon starts and fails with its own
# "SIGNET_API_TOKEN must be set to serve", which names the actual problem.
EnvironmentFile=-{{ signet_env_file }}
Environment=SIGNET_ADDR={{ signet_addr }}
ExecStart={{ signet_binary }} serve
# `always`, not `on-failure`: this daemon's observed failure mode is a CLEAN exit
# (status=0/SUCCESS), which on-failure does not cover by definition. It died that
# way twice in ten days — Jul 27→Jul 30 and Aug 3→Aug 5 — staying down for days
# with the unit still `enabled`, taking Switchyard's Credentials and Audit
# surfaces dark with it. A vault daemon exiting 0 on its own is never a desired
# end state (SERV-70). This stops the outage; it does not diagnose it — why the
# daemon returns 0 is SGNT-19, and the probe that would have caught either outage
# on day one is SERV-86. Note the StartLimit above deliberately allows a broken
# unit to rest in `failed`, so that probe is what covers this now.
Restart=always
RestartSec=5s

# Hardening — the vault (key + DB) is the only thing this daemon should touch.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={{ signet_state_dir }}
PrivateTmp=true

[Install]
WantedBy=multi-user.target
