# {{ ansible_managed }}
# Signet daemon secrets. Consumed by the signet.service unit's EnvironmentFile.
# SIGNET_API_TOKEN is the bearer the Switchyard connector (SWY-165) presents;
# the same value must be set as SIGNET_API_TOKEN in the stack .env so the
# switchyard container authenticates. Sourced from `signet_api_token` (SOPS).
SIGNET_API_TOKEN={{ signet_api_token }}
