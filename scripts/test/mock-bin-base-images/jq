#!/usr/bin/env bash
# A PATH shim over the real jq, for one purpose: make the document's assembly fail on demand.
# With MOCK_JQ_FAIL_ASSEMBLY=1 it exits 5 for the one invocation whose argv carries
# `--arg generatedAt` (check-base-images.sh's write_document; no other jq call uses that
# argument) and passes every other call straight through. Without the variable it is
# invisible.
self="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ "${MOCK_JQ_FAIL_ASSEMBLY:-}" = 1 ]; then
  prev=""
  for a in "$@"; do
    if [ "$prev" = "--arg" ] && [ "$a" = generatedAt ]; then echo "mock jq: injected assembly failure" >&2; exit 5; fi
    prev="$a"
  done
fi
IFS=: read -ra dirs <<<"$PATH"
for dir in "${dirs[@]}"; do
  [ "$(cd -- "$dir" 2>/dev/null && pwd)" = "$self" ] && continue
  [ -x "$dir/jq" ] && exec "$dir/jq" "$@"
done
echo "mock jq: no real jq on PATH" >&2; exit 127
