# Dev environment secrets (SERV-77) — the template for DEV_ENV_FILE.
#
# This file has the SAME KEY NAMES as .env.example on purpose. Dev is not a
# different shape of environment, it is the same shape holding different values,
# which is what lets SGNT-24 later render both from one vault project without the
# stack changing how it reads anything.
#
# WHERE THIS LIVES
#   Prod:  PROD_ENV_FILE  on the `home-server`     GitHub Environment
#   Dev:   DEV_ENV_FILE   on the `home-server-dev` GitHub Environment
#
# BOTH ARE RENDERED BY SIGNET — do not `gh secret set` either one. A hand-set value
# works until the next `signet sync` reverts it, which is the worst kind of wrong: live
# now, gone when something unrelated runs. Change the value in the vault instead:
#
#   signet set --project construct-server-dev --name SOME_TOKEN
#   signet sync
#
#   Vault project: construct-server-dev   (file target: creds/dev.env)
#   Deployed to:   /opt/construct-server-dev/.env, by deploy-dev.yml via render-env.sh
#
# See docs/dev-environment.md for how the vault project was established, and for why it
# is seeded from creds/dev.env rather than from the deployed .env.
#
# NEVER COPY THE PROD .env HERE. SERV-77 is explicit about it and the reason is
# concrete: purser provisions real accounts across Switchyard, Lyceum, Argosy and
# Cloudflare Access. A dev purser holding prod credentials does not fail safely —
# it succeeds, against production.
#
# Generate every password and token fresh:
#   openssl rand -hex 24
#
# Keys deliberately absent from dev (see scripts/check-dev-parity.sh for the list
# and the reason each is skipped): SIGNET_*, CF_ACCESS_*, GITHUB_TOKEN,
# GITHUB_WEBHOOK_SECRET, PURSER_CF_*, the Lyceum SMTP block, and OPEN_SUBTITLES_*.
# Leaving them out is what keeps dev from acting on real vaults, tenants,
# repositories and mailboxes.
#
# NO GITHUB_USER / GITHUB_PAT EITHER, unlike .env.example. Prod logs in to GHCR before
# pulling; dev does not need to, because all four first-party dev images are public
# packages (verified with an anonymous `docker manifest inspect`). Dev therefore holds no
# GitHub credential of any kind, which is the stronger version of the rule above.
#
# NO DEV_*_TAG KEYS. Dev's image pins live in the tracked `dev-versions.env` (SERV-97) —
# an image tag is not a credential, and keeping it in git makes a version change a
# reviewable diff. `deploy-dev.yml` merges the two into the deployed .env with
# scripts/render-env.sh; a DEV_*_TAG written here would be stripped and replaced by that
# render, so it would look set and have no effect.

# --- DEV DATABASE (postgres-dev, its own server — not the prod postgres) ---
# The superuser password for the dev Postgres. Unrelated to the prod one.
POSTGRES_PASSWORD=change_me
# Per-service roles, created by db/init-db.sh inside postgres-dev. These are also
# read by the postgres-dev container itself, which is where init-db.sh runs.
SWITCHYARD_DB_PASSWORD=change_me
ARGOSY_DB_PASSWORD=change_me
LYCEUM_DB_PASSWORD=change_me
PURSER_DB_PASSWORD=change_me

# --- SWITCHYARD (dev) ---
# Prints once on first boot when no api_tokens exist; blank auto-generates.
SWITCHYARD_BOOTSTRAP_TOKEN=

# --- ARGOSY (dev) ---
ARGOSY_ADMIN_USERNAME=admin
ARGOSY_ADMIN_PASSWORD=change_me
# Gates POST /api/v1/admin/accounts; dev purser presents it as X-Provision-Token.
# Must match between argosy-dev and purser-dev or provisioning fails closed.
ARGOSY_PROVISION_TOKEN=change_me
# TMDB is optional in dev — blank just means no artwork or metadata lookups.
TMDB_API_READ_ACCESS_KEY=
TMDB_API_KEY=
# Host media libraries, mounted READ-ONLY into dev. Sharing prod's libraries is
# safe because of :ro and saves a second copy of the media.
ARGOSY_MEDIA_DIR_HOST=/data/media
# Periodic scanning is off in dev (0). Trigger one by hand: POST /api/v1/scan.
DEV_ARGOSY_SCAN_INTERVAL=0

# --- LYCEUM (dev) ---
LYCEUM_BOOKS_DIR_HOST=/data/media/books
# Household accounts. `false` leaves the dev reader open with no sign-in, which is
# friendlier to click around — but it is NOT free: `/admin/users` is owner-gated and
# 403s with auth off, so purser's Lyceum connector cannot work at all. That leg is why
# lyceum is in the dev slice (SERV-81), so prefer `true` unless you are only reading.
# Verified both ways: 403 with auth off, 200 with auth on and an owner session token.
DEV_LYCEUM_AUTH=true

# --- PURSER (dev) ---
PURSER_API_TOKEN=change_me
# An owner SESSION token (lyc_...) for the DEV lyceum, not a LYCEUM_API_TOKENS entry.
# TWO steps, not one — `mint-token` issues a one-time INVITE, which must then be
# redeemed for the durable session token purser actually holds:
#
#   inv=$(docker exec lyceum-dev lyceum mint-token | head -1)
#   curl -sX POST http://localhost:14005/auth/session -H 'Content-Type: application/json' \
#        -d "{\"token\":\"$inv\",\"device_label\":\"purser-dev\"}"
#
# The owner account is created automatically (Reader / owner@localhost) — nothing needs
# seeding, despite LYCEUM_OWNER_EMAIL being absent from dev on purpose. Needs
# DEV_LYCEUM_AUTH=true above, or the token is inert.
# Blank => the Lyceum connector reports Unavailable, which is fine for a dev run
# that is not exercising provisioning.
PURSER_LYCEUM_OWNER_TOKEN=

# --- DEV PORTS (all bound to 127.0.0.1 by docker-compose.dev.yml) ---
# Offset from prod so both can run at once. Loopback-bound on purpose: dev is
# reached from this host or through the tunnel, never from the LAN.
DEV_POSTGRES_PORT=55432
DEV_SWITCHYARD_PORT=14002
DEV_ARGOSY_PORT=18096
DEV_LYCEUM_PORT=14005
DEV_PURSER_PORT=14006

# --- DEV EDGE (SERV-93) ---
# The credential for dev's OWN Cloudflare tunnel — a second tunnel, not a second
# connector on prod's. Two connectors sharing one token would let Cloudflare route a
# prod hostname to the dev one, which cannot serve it.
#
# THIS VARIABLE IS THE SWITCH. traefik-dev, cf-access-guard-dev and cloudflared-dev
# carry `profiles: [edge]`, and the Makefile turns that profile on exactly when this
# is non-empty. Leave it blank on a dev root that never had an edge and dev runs on
# its loopback ports as before — the right state until the Cloudflare Zero Trust half
# exists, because an empty TUNNEL_TOKEN does not disable cloudflared, it crash-loops
# it.
#
# TURNING IT OFF AGAIN IS NOT SYMMETRICAL, so do not just blank this and walk away.
# `compose up -d` with a profile off does not STOP the containers that profile
# created — measured, not assumed — so on a dev root whose edge is already up,
# removing this leaves the tunnel connected and the hostnames served. `make dev-up`
# now reconciles that (it takes the edge down when the token is gone) and
# `make dev-edge-down` does it immediately, but a hand-edit followed by nothing at all
# leaves a live edge that every intent-based check calls "not deployed".
#
# Blank here on purpose. docs/dev-environment.md has the dashboard runbook: create
# the dev tunnel, copy its token here, point each dev hostname at
# http://traefik-dev:9080, create one Access application per hostname, and put their
# AUDs in CF_ACCESS_AUD_MAP on cf-access-guard-dev in docker-compose.dev.yml (tracked
# in git — an AUD is a public application identifier, not a credential).
DEV_CLOUDFLARE_TUNNEL_TOKEN=

# enforce | audit, for cf-access-guard-dev. `audit` logs the decision it WOULD have
# made and serves the request anyway; it exists to rehearse a cutover and is not a
# steady state. `make dev-edge-auth-check` FAILS while it is set, which is what stops
# it surviving here. Omit it entirely unless you are mid-cutover.
# DEV_CF_ACCESS_GUARD_MODE=enforce

# --- DEV PUBLIC URLs ---
# What dev services put in user-facing links (invites, deep links), AND what each
# service advertises as its own address — one variable per service, not two, so
# there is no way to update the link and forget the self-advertised URL.
#
# Loopback is the correct value while DEV_CLOUDFLARE_TUNNEL_TOKEN is blank, and it
# stays correct for argosy afterwards. Once the dev edge is up, switch the two
# tunneled services to their hostnames:
#
#   DEV_SWITCHYARD_PUBLIC_URL=https://switchyard-dev.zerogravity.industries
#   DEV_LYCEUM_PUBLIC_URL=https://lyceum-dev.zerogravity.industries
#
# ARGOSY HAS NO HOSTNAME AND IS NOT AN OVERSIGHT. Video does not go through the
# tunnel — that is why prod Argosy gets a direct WAN path instead — and dev shares
# prod's media libraries read-only, so a dev hostname would stream the same files
# through the same tunnel. Dev has no direct path to offer instead (CGNAT, and host
# 443 belongs to prod), so argosy-dev stays on loopback.
DEV_SWITCHYARD_PUBLIC_URL=http://localhost:14002
DEV_LYCEUM_PUBLIC_URL=http://localhost:14005
DEV_ARGOSY_PUBLIC_URL=http://localhost:18096
