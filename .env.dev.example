# Dev environment secrets (SERV-77) — the template for DEV_ENV_FILE.
#
# This file has the SAME KEY NAMES as .env.example on purpose. Dev is not a
# different shape of environment, it is the same shape holding different values,
# which is what lets SGNT-24 later render both from one vault project without the
# stack changing how it reads anything.
#
# WHERE THIS LIVES
#   Prod:  PROD_ENV_FILE  on the `home-server`     GitHub Environment
#   Dev:   DEV_ENV_FILE   on the `home-server-dev` GitHub Environment
#
#   Update:  gh secret set DEV_ENV_FILE --env home-server-dev < your-dev.env
#   Deployed to: /opt/construct-server-dev/.env
#
# NEVER COPY THE PROD .env HERE. SERV-77 is explicit about it and the reason is
# concrete: purser provisions real accounts across Switchyard, Lyceum, Argosy and
# Cloudflare Access. A dev purser holding prod credentials does not fail safely —
# it succeeds, against production.
#
# Generate every password and token fresh:
#   openssl rand -hex 24
#
# Keys deliberately absent from dev (see scripts/check-dev-parity.sh for the list
# and the reason each is skipped): SIGNET_*, CF_ACCESS_*, GITHUB_TOKEN,
# GITHUB_WEBHOOK_SECRET, PURSER_CF_*, the Lyceum SMTP block, and OPEN_SUBTITLES_*.
# Leaving them out is what keeps dev from acting on real vaults, tenants,
# repositories and mailboxes.

# --- DEV DATABASE (postgres-dev, its own server — not the prod postgres) ---
# The superuser password for the dev Postgres. Unrelated to the prod one.
POSTGRES_PASSWORD=change_me
# Per-service roles, created by db/init-db.sh inside postgres-dev. These are also
# read by the postgres-dev container itself, which is where init-db.sh runs.
SWITCHYARD_DB_PASSWORD=change_me
ARGOSY_DB_PASSWORD=change_me
LYCEUM_DB_PASSWORD=change_me
PURSER_DB_PASSWORD=change_me

# --- SWITCHYARD (dev) ---
# Prints once on first boot when no api_tokens exist; blank auto-generates.
SWITCHYARD_BOOTSTRAP_TOKEN=
# What the dev Switchyard believes its own address is. Loopback by default;
# change to the dev tunnel hostname once that exists.
SWITCHYARD_PUBLIC_URL=http://localhost:14002

# --- ARGOSY (dev) ---
ARGOSY_ADMIN_USERNAME=admin
ARGOSY_ADMIN_PASSWORD=change_me
# Gates POST /api/v1/admin/accounts; dev purser presents it as X-Provision-Token.
# Must match between argosy-dev and purser-dev or provisioning fails closed.
ARGOSY_PROVISION_TOKEN=change_me
# TMDB is optional in dev — blank just means no artwork or metadata lookups.
TMDB_API_READ_ACCESS_KEY=
TMDB_API_KEY=
# Host media libraries, mounted READ-ONLY into dev. Sharing prod's libraries is
# safe because of :ro and saves a second copy of the media.
ARGOSY_MEDIA_DIR_HOST=/data/media
# Periodic scanning is off in dev (0). Trigger one by hand: POST /api/v1/scan.
DEV_ARGOSY_SCAN_INTERVAL=0

# --- LYCEUM (dev) ---
LYCEUM_BOOKS_DIR_HOST=/data/media/books
# Household accounts. Off by default so the dev reader is open and no dev user
# has to be seeded to click around.
DEV_LYCEUM_AUTH=false

# --- PURSER (dev) ---
PURSER_API_TOKEN=change_me
# An owner SESSION token for the DEV lyceum, not a LYCEUM_API_TOKENS entry.
# Mint against lyceum-dev: docker exec lyceum-dev lyceum mint-token
# Blank => the Lyceum connector reports Unavailable, which is fine for a dev run
# that is not exercising provisioning.
PURSER_LYCEUM_OWNER_TOKEN=

# --- DEV PORTS (all bound to 127.0.0.1 by docker-compose.dev.yml) ---
# Offset from prod so both can run at once. Loopback-bound on purpose: dev is
# reached from this host or through the tunnel, never from the LAN.
DEV_POSTGRES_PORT=55432
DEV_SWITCHYARD_PORT=14002
DEV_ARGOSY_PORT=18096
DEV_LYCEUM_PORT=14005
DEV_PURSER_PORT=14006

# --- DEV PUBLIC URLs ---
# What dev services put in user-facing links (invites, deep links). Loopback
# until the dev tunnel hostnames are configured in Cloudflare; then set these to
# https://<svc>-dev.zerogravity.industries and nothing else changes.
DEV_SWITCHYARD_PUBLIC_URL=http://localhost:14002
DEV_LYCEUM_PUBLIC_URL=http://localhost:14005
DEV_ARGOSY_PUBLIC_URL=http://localhost:18096
