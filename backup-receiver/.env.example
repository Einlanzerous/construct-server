# Backup receiver configuration (SERV-43 / SERV-167).
# Copy to .env and fill in.  cp .env.example .env
#
# .env holds a password. It is gitignored in construct-server, and if you copied
# this bundle somewhere else, keep it out of version control there too.

# ── tailnet identity ─────────────────────────────────────────────────────────

# The name this receiver takes on the tailnet. This is how the construct server
# addresses the destination, so pick something that says what the machine is:
#   imperial-prime-wsl   the desktop's WSL2 side
#   arin-server          Arin's box
#   nas                  a NAS
TS_HOSTNAME=imperial-prime-wsl

# A Tailscale auth key. ONLY needed the first time — after the node authenticates,
# its identity lives in the backup_receiver_tailscale_state volume and this can go
# back to empty.
#
# Generate one at https://login.tailscale.com/admin/settings/keys
# A reusable key is convenient; an ephemeral key is NOT appropriate here, because
# an ephemeral node is removed from the tailnet when it goes offline and this one
# is meant to be a durable destination.
TS_AUTHKEY=

# Optional extra flags for `tailscale up`. Tagging the node makes it addressable
# in ACLs later, which is how Arin's access gets scoped when that lands:
#   TS_EXTRA_ARGS=--advertise-tags=tag:backup-receiver
# Note a tagged node needs an auth key authorised for that tag.
TS_EXTRA_ARGS=

# ── repository credentials ───────────────────────────────────────────────────
#
# These authenticate the construct server TO this receiver. They are NOT the
# restic repository password — that one never leaves the construct server, and
# is what keeps the contents unreadable to whoever runs this host.

REST_USER=construct

# Generate with:  openssl rand -base64 24
# Then give it to the construct server as part of the repository URL.
REST_PASSWORD=

# Optional extra rest-server flags. --append-only is already set in
# docker-compose.yml and must stay; do not restate it here.
# A size cap can be useful on a shared machine:
#   REST_EXTRA_OPTIONS=--max-size=200000000000
REST_EXTRA_OPTIONS=
